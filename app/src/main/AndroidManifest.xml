<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Granted once over adb to allow lifting grayscale in the viewer (optional) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        Directions to the venue, handed to BrightWay by name. Addressing an intent to a
        package makes that package invisible on API 30 and up unless it is declared here,
        and an invisible package means startActivity throws instead of resolving. The
        `geo:` fallback needs nothing: implicit intent resolution is not filtered.
    -->
    <queries>
        <package android:name="com.gios.brightway" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Movie Tickets"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightPass">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Movie Tickets"
            android:theme="@style/Theme.LightPass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- lightpass://pass/<id> opens that ticket. LightNotebook uses this to jump
                 from a film on the calendar straight to the stub. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lightpass" android:host="pass" />
            </intent-filter>
        </activity>

        <!-- Dates and titles only, and only for the tools listed in PassProvider. -->
        <provider
            android:name=".data.PassProvider"
            android:authorities="com.gios.lightpass.passes"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
